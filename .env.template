### LINE API ###
### Get the following from LINE Developers Console ###
### https://developers.line.biz/console/ ###
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret

### ENVIRONMENT ###
DEV_MODE=True
PORT=5000

### AI ###
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini

### FIREBASE / GOOGLE CLOUD ###
GOOGLE_CLOUD_PROJECT=your-firebase-project-id
# Production uses the Cloud Run service account (Application Default Credentials).
# Local development: gcloud auth application-default login
# Emulator only; never set this in Cloud Run:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085

### CAMPUS REST API (MCP URL is fixed in the agent) ###
API_ENDPOINT=https://api.nthusa.tw