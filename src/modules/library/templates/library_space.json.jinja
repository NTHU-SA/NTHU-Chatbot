{
    "type": "bubble",
    "header": {
        "type": "box",
        "layout": "vertical",
        "contents": [
            {
                "type": "box",
                "layout": "vertical",
                "contents": []
            },
            {
                "type": "text",
                "text": "圖書館空間現況",
                "size": "lg",
                "align": "center",
                "action": {
                    "type": "uri",
                    "label": "圖書館預約系統",
                    "uri": "https://libsms.lib.nthu.edu.tw/build/"
                },
                "color": "#FFFFFF"
            }
        ],
        "backgroundColor": "#73438d"
    },
    "body": {
        "type": "box",
        "layout": "vertical",
        "contents": [
            {
                "type": "box",
                "layout": "horizontal",
                "contents": [
                    {
                        "type": "text",
                        "text": "空間區域",
                        "size": "sm",
                        "color": "#111111",
                        "weight": "bold"
                    },
                    {
                        "type": "text",
                        "text": "尚有空間",
                        "size": "sm",
                        "color": "#111111",
                        "align": "end",
                        "weight": "bold"
                    }
                ],
                "height": "30px"
            },
            {% for space in spaces %}
            {
                "type": "box",
                "layout": "horizontal",
                "contents": [
                    {
                        "type": "text",
                        "text": {{ space.zonename | default('-', true) | tojson }},
                        "size": "sm",
                        "color": "#555555",
                        "flex": 0,
                        "align": "center"
                    },
                    {
                        "type": "text",
                        "text": {{ space.count | default('-') | string | tojson }},
                        "size": "sm",
                        "color": "#555555",
                        "align": "end"
                    }
                ]
            }{% if not loop.last %},{% endif %}
            {% endfor %}
        ]
    },
    "footer": {
        "type": "box",
        "layout": "vertical",
        "contents": [
            {
                "type": "button",
                "action": {
                    "type": "uri",
                    "label": "預約空間",
                    "uri": "https://libsms.lib.nthu.edu.tw/build/"
                },
                "height": "sm"
            },
            {
                "type": "button",
                "action": {
                    "type": "message",
                    "label": "更新資訊",
                    "text": "@圖書館/空間狀況"
                },
                "height": "sm"
            },
            {
                "type": "button",
                "action": {
                    "type": "postback",
                    "label": "回到首頁",
                    "data": "@圖書館"
                },
                "height": "sm"
            }
        ]
    },
    "styles": {
        "footer": {
            "separator": true
        }
    }
}